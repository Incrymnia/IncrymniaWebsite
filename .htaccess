# Apache: serve index.php by default and block private config files
DirectoryIndex index.php
<FilesMatch "^config(\.local|\.local\.example)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
